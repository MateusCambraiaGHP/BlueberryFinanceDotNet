@* Inline add/edit form panel with a colored left border.
   Usage:
     <SectionFormCard Title="New Bank Account">
         <FormContent>... fields ...</FormContent>
         <FormActions>
             <MudButton ...>Save</MudButton>
             <MudButton ...>Cancel</MudButton>
         </FormActions>
     </SectionFormCard> *@

<MudCard Elevation="1" Class="mb-6 pa-5" Style="@($"border-radius:12px;border-left:4px solid {BorderColor}")">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <MudText Typo="Typo.subtitle1" Style="font-weight:600;color:#0f1b2d;margin-bottom:16px">@Title</MudText>
    }
    @FormContent
    @if (FormActions is not null)
    {
        <MudStack Row="true" Class="mt-4" Spacing="2">
            @FormActions
        </MudStack>
    }
</MudCard>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string BorderColor { get; set; } = "#4f8ef7";
    [Parameter, EditorRequired] public RenderFragment? FormContent { get; set; }
    [Parameter] public RenderFragment? FormActions { get; set; }
}
