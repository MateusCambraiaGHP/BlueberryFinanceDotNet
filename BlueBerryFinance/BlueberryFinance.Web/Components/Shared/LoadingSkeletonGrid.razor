@* Usage: <LoadingSkeletonGrid Count="3" Height="120px" Xs="12" Sm="6" Md="4" /> *@

<MudGrid>
    @for (int i = 0; i < Count; i++)
    {
        <MudItem xs="@Xs" sm="@Sm" md="@Md">
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="@Height" Class="rounded-lg" />
        </MudItem>
    }
</MudGrid>

@code {
    [Parameter] public int Count { get; set; } = 3;
    [Parameter] public string Height { get; set; } = "120px";
    [Parameter] public int Xs { get; set; } = 12;
    [Parameter] public int Sm { get; set; } = 6;
    [Parameter] public int Md { get; set; } = 4;
}
