@* Colored chip for type labels. Auto-colors Income (green) / Expense (red) with IsIncomeExpense=true,
   or pass AccentColor for a custom tinted chip.
   Usage:
     <TypeBadge Label="@context.TransactionType" IsIncomeExpense="true" />
     <TypeBadge Label="Pending" AccentColor="#d69e2e" /> *@

<MudChip T="string" Size="Size.Small" Style="@_style">@Label</MudChip>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public bool IsIncomeExpense { get; set; }
    [Parameter] public string Background { get; set; } = "rgba(79,142,247,0.12)";
    [Parameter] public string Color { get; set; } = "#4f8ef7";
    [Parameter] public string? AccentColor { get; set; }

    private string _style => BuildStyle();

    private string BuildStyle()
    {
        const string common = "font-size:.75rem;height:22px";

        if (IsIncomeExpense)
        {
            return string.Equals(Label, "Income", StringComparison.OrdinalIgnoreCase)
                ? $"background:rgba(56,161,105,0.12);color:#38a169;{common}"
                : $"background:rgba(229,62,62,0.12);color:#e53e3e;{common}";
        }

        if (AccentColor is not null)
            return $"background:{AccentColor}22;color:{AccentColor};{common}";

        return $"background:{Background};color:{Color};{common}";
    }
}
